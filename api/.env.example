SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_JWT_SECRET=
NASA_FIRMS_MAP_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# WhatsApp (Meta Cloud API). The access token from API Setup expires after 24 hours; WHATSAPP_VERIFY_TOKEN is any phrase you choose.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
GRAPH_API_VERSION=v25.0
# Public https URL Meta calls (a tunnel while developing), no trailing path. Also trusted as an allowed host.
PUBLIC_BASE_URL=

# LLM parser for WhatsApp messages (Gemini).
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# MOCK flags. Both default to true. Set each to false once its keys above are real.
MOCK_WHATSAPP_SEND=true
MOCK_LLM_PARSER=true

# Demo only: lets the verification route return a fixed verdict (?scenario=). Keep false outside demos.
ALLOW_VERIFICATION_SCENARIOS=false
