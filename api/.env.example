SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_JWT_SECRET=
NASA_FIRMS_MAP_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# WhatsApp (Twilio sandbox). TWILIO_WHATSAPP_FROM looks like whatsapp:+1XXXXXXXXXX.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public https URL Twilio calls (a tunnel while developing), no trailing path. Also trusted as an allowed host.
PUBLIC_BASE_URL=

# LLM parser for WhatsApp messages (Gemini).
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# MOCK flags. Both default to true. Set to false once the keys above are real.
MOCK_WHATSAPP_SEND=true
MOCK_LLM_PARSER=true

# Demo only: lets the verification route return a fixed verdict (?scenario=). Keep false outside demos.
ALLOW_VERIFICATION_SCENARIOS=false
